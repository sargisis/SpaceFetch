
# Stage 1: Build React frontend production assets
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
# Plain RUN (no BuildKit cache mounts) so the build works on the legacy builder too
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: Build Go binary
FROM golang:1.26-alpine AS backend-builder
WORKDIR /app
COPY go.mod go.sum ./
# Vendored modules: the build needs no network access for Go dependencies
COPY vendor vendor
COPY cmd cmd
COPY internal internal
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -o api ./cmd/api

# Stage 3: Runtime container
FROM alpine:3.20
RUN apk --no-cache add ca-certificates && adduser -D -H -u 10001 app
WORKDIR /app

# Copy Go binary
COPY --from=backend-builder /app/api .

# Copy built frontend assets
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

USER app

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["./api"]
