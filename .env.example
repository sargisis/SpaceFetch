# Get a free personal key at https://api.nasa.gov (DEMO_KEY is limited to 30 req/hour)
NASA_API_KEY=DEMO_KEY
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=spacefetch
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
API_PORT=8080
WORKER_INTERVAL=6h
CACHE_TTL=3600
GROQ_API_KEY=
FRONTEND_DIR=./frontend/dist
# Comma-separated list of allowed frontend origins for CORS.
# Localhost dev origins (5173, 8080) are always allowed automatically.
# In production add your public URL, e.g. https://YOUR_APP.pages.dev
# Set to "true" to mark session cookies as Secure (HTTPS-only).
# Must be enabled in production; leave off for local HTTP dev.
COOKIE_SECURE=false
ALLOWED_ORIGIN=
