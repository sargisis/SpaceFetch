
# Stage 1: Build binary
FROM golang:1.26-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
# Vendored modules: the build needs no network access for Go dependencies
COPY vendor vendor

# Copy source code and build (only what's needed)
COPY cmd cmd
COPY internal internal
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -o worker ./cmd/worker

# Stage 2: Runtime image
FROM alpine:3.20
RUN apk --no-cache add ca-certificates && adduser -D -H -u 10001 app
WORKDIR /app
COPY --from=builder /app/worker .

USER app

CMD ["./worker"]
